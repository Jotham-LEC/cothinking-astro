---
// A call to action: the yellow button, or `secondary`, an outlined one
// (`.button` and `.button-secondary`, styles/components.css, which Markdown
// uses too as `<a class="button">`). A link with `href`, else a <button>.
import type { HTMLAttributes } from 'astro/types';
type Props = { secondary?: boolean } & (({ href: string } & HTMLAttributes<'a'>) | ({ href?: undefined } & HTMLAttributes<'button'>));
const { secondary = false, class: className, ...rest } = Astro.props;
const classes = ['not-prose button', { 'button-secondary': secondary }, className];
---

{rest.href !== undefined ? (
  <a class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    <slot />
  </a>
) : (
  <button type="submit" class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <slot />
  </button>
)}
