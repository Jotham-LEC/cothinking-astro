---
// The header: the logo, search, the `header` navigation, reader mode, the
// theme toggle and the menu button that opens the Explorer's drawer.
import { site } from '../lib/load.ts';
import type { Link } from '../lib/explorer.ts';
import Bars from '../assets/icons/bars-3.svg';
import BookOpen from '../assets/icons/book-open.svg';
import MagnifyingGlass from '../assets/icons/magnifying-glass.svg';
import Moon from '../assets/icons/moon.svg';
import Sun from '../assets/icons/sun.svg';
type Props = { room: boolean; hasExplorer: boolean; hasDrawer: boolean; links: Link[] };
const { room, hasExplorer, hasDrawer, links } = Astro.props;
const last = links.length - 1;
const icon =
  'text-muted hover:bg-bg-elev hover:text-fg flex size-9 shrink-0 items-center justify-center rounded-lg pointer-coarse:size-11';
---

<header class="border-rule bg-bg/90 sticky top-0 z-30 flex min-h-14 flex-wrap items-center gap-1 border-b px-4 backdrop-blur sm:gap-3 sm:px-6 print:hidden">
  <a class="text-heading flex shrink-0 items-center gap-2.5 font-semibold whitespace-nowrap no-underline" href="/">
    {/* The site's logo: a wordmark with its dark-mode twin, or a portrait beside the name.
        Below 400px a wordmark's favicon stands in for it; below 360px the logo goes. */}
    {site.logoDark ? (
      <>
        <img
          class:list={['size-7 min-[400px]:hidden', { 'max-[359px]:hidden': hasDrawer }]}
          src={site.favicon}
          alt={site.name}
          width="28"
          height="28"
        />
        <img
          class="light-only h-7 w-auto max-[399px]:hidden!"
          src={site.logo}
          alt={site.name}
          width="122"
          height="28"
        />
        <img
          class="dark-only h-7 w-auto max-[399px]:hidden!"
          src={site.logoDark}
          alt={site.name}
          width="122"
          height="28"
        />
      </>
    ) : (
      <>
        <img class="size-7 rounded-full" src={site.logo} alt="" width="400" height="400" />
        {/* Below 380px the name gives way to "Work with me"; screen readers still hear it. */}
        <span class="max-[380px]:sr-only">{site.name}</span>
      </>
    )}
  </a>
  <button
    type="button"
    class="border-rule bg-bg-elev text-muted hover:border-rule-strong hover:text-fg ml-2 hidden h-9 items-center gap-2 rounded-lg border px-3 text-sm sm:flex"
    data-palette-open
  >
    <MagnifyingGlass class="size-4" aria-hidden="true" />
    <span>
      <span class="text-accent font-mono" aria-hidden="true">
        $
      </span>{' '}
      search…
    </span>
    <kbd class="border-rule rounded border px-1.5 font-mono text-[0.65rem]" data-kbd-trigger>
      ⌘K
    </kbd>
  </button>
  <button type="button" class:list={[icon, 'sm:hidden']} aria-label="Search" data-palette-open>
    <MagnifyingGlass class="size-5" aria-hidden="true" />
  </button>
  {/* The header navigation: the last link is the call to action; the others show from xl, and in the drawer below it. */}
  <nav class="ml-auto flex items-center gap-1" aria-label="Header">
    {links.map((link, i) => (
      <a
        href={link.url}
        aria-current={link.isCurrent ? 'page' : undefined}
        class:list={[
          'text-sm whitespace-nowrap no-underline',
          i !== last &&
            'text-muted hover:bg-bg-elev hover:text-fg aria-[current=page]:text-fg hidden rounded-lg px-3 py-2.5 font-medium xl:inline-block',
          i === last &&
            'rounded-site bg-button-bg text-button-fg ml-1 inline-block px-3 py-1.5 font-semibold transition hover:brightness-95 pointer-coarse:py-2.5',
        ]}
      >
        {link.title}
      </a>
    ))}
  </nav>
  {/* Reader mode, from lg: puts the Explorer and the rail away together, pressed while they are. Its label shows from xl. */}
  {!room && (
    <button
      class="group rounded-site border-subtle text-heading hover:bg-bg-elev aria-pressed:border-accent aria-pressed:bg-bg-elev aria-pressed:text-accent relative hidden h-9 shrink-0 items-center justify-center gap-2 border px-3 text-sm font-semibold lg:flex"
      type="button"
      aria-label="Reader mode"
      aria-pressed="false"
      aria-keyshortcuts="z"
      data-reader-toggle
    >
      <BookOpen class="size-5" aria-hidden="true" />
      <span class="hidden xl:inline" aria-hidden="true">
        Reader
      </span>
      <span
        class="border-rule bg-bg text-fg pointer-events-none absolute top-full right-0 mt-2 hidden rounded-lg border px-2.5 py-1.5 text-xs whitespace-nowrap shadow-lg group-hover:block group-focus-visible:block"
        aria-hidden="true"
      >
        <span class="group-aria-pressed:hidden">Hide both side panels</span>
        <span class="hidden group-aria-pressed:inline">Show the side panels</span>
        <kbd class="border-rule bg-bg-elev ml-1.5 rounded border px-1 font-mono text-[0.65rem]">z</kbd>
      </span>
    </button>
  )}
  {/* The theme toggle shows the scheme in effect (CSS picks the icon); the script flips it. */}
  <button class={icon} type="button" aria-label="Switch colour scheme" data-theme-toggle>
    <Sun class="light-only size-5" aria-hidden="true" />
    <Moon class="dark-only size-5" aria-hidden="true" />
  </button>
  {/* The menu, last as on most phones: it opens the drawer, with the header's links above the Explorer.
      From lg the Explorer is a column and from xl the links are in the header, so it goes. */}
  {hasDrawer && (
    <button
      class:list={[icon, { 'lg:hidden': !room, 'xl:hidden': room && !hasExplorer }]}
      type="button"
      aria-label="Menu"
      popovertarget="explorer"
    >
      <Bars class="size-5" aria-hidden="true" />
    </button>
  )}
</header>

<script>
  import { initTheme } from '../scripts/theme.ts';
  import { initReader } from '../scripts/reader.ts';
  initTheme();
  initReader();
</script>
