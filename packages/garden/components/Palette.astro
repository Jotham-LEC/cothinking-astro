---
// ⌘K search: a native dialog (focus stays inside it, Esc and a click
// outside close it, an open drawer is put away as it opens). The site's
// pages are listed up front, in their order; from two characters
// scripts/palette.ts asks Pagefind and builds the results.
import type { SiteEntry } from '../lib/entry.ts';
type Props = { live: SiteEntry[] };
const { live } = Astro.props;
const root = live.filter((p) => p.collection === 'pages').sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
---

<dialog
  id="palette"
  class="rounded-site border-rule-strong bg-bg text-fg backdrop:bg-fg/30 mx-auto mt-[12vh] w-[min(38rem,92vw)] overflow-hidden border p-0 shadow-2xl backdrop:backdrop-blur-xs print:hidden"
  closedby="any"
  aria-label="Quick search"
  data-pagefind-ignore
>
  <div class="border-rule focus-within:outline-accent flex items-center gap-2.5 border-b px-4 py-3.5 focus-within:outline-2 focus-within:-outline-offset-2">
    <span class="text-accent font-mono" aria-hidden="true">
      $
    </span>
    <input
      class="text-fg placeholder:text-muted [&::-webkit-search-cancel-button]:appearance-none flex-1 bg-transparent text-base outline-none"
      type="search"
      placeholder="Search pages…"
      aria-label="Search pages"
      autocomplete="off"
      autofocus
      data-palette-input
    />
    <form method="dialog">
      <button class="-m-2 p-2" type="submit" aria-label="Close search">
        <kbd class="border-rule text-muted rounded border px-1.5 font-mono text-[0.65rem] pointer-coarse:hidden">esc</kbd>
        <span class="text-muted hidden text-sm pointer-coarse:inline" aria-hidden="true">
          Close
        </span>
      </button>
    </form>
  </div>
  {/* How many results, for a screen reader (the script sets it). */}
  <p class="sr-only" role="status" aria-live="polite" data-palette-status></p>
  {/* A stable floor and ceiling keep the panel from resizing as results swap. */}
  <ul
    class="[&_a]:flex [&_a]:flex-wrap [&_a]:items-baseline [&_a]:gap-3 [&_a]:px-4 [&_a]:py-2 [&_a]:text-sm [&_a]:text-fg [&_a]:no-underline [&_a:hover]:bg-bg-elev max-h-[50vh] min-h-32 [scrollbar-gutter:stable] overflow-y-auto py-1.5"
    data-palette-results
  >
    {root.map((p) => (
      <li>
        <a href={p.url} data-label={p.title.toLowerCase()}>
          <span class="palette-title">{p.title}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="border-rule bg-bg-elev text-muted [&_kbd]:mr-1 [&_kbd]:rounded [&_kbd]:border [&_kbd]:border-rule [&_kbd]:bg-bg [&_kbd]:px-1 [&_kbd]:font-mono [&_kbd]:text-[0.65rem] flex gap-4 border-t px-4 py-2 text-xs">
    <span>
      <kbd>↑</kbd>
      <kbd>↓</kbd> navigate
    </span>
    <span>
      <kbd>↵</kbd> open
    </span>
    <span>
      <kbd>esc</kbd> close
    </span>
    <span class="ml-auto hidden sm:inline">
      <kbd>/</kbd> search
    </span>
    <span class="hidden sm:inline">
      <kbd>?</kbd> keys
    </span>
  </div>
</dialog>

<script>
  import { initPalette } from '../scripts/palette.ts';
  initPalette();
</script>
