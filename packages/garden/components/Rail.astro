---
// The rail: the local graph, the outline (wide screens) and the pages that
// link here; each hides when it has nothing.
import type { SiteEntry } from '../lib/entry.ts';
import type { TocEntry } from '../lib/toc.ts';
import type { GraphNode } from '../lib/graph.ts';
import { site } from '../lib/load.ts';
import GraphControls from './GraphControls.astro';
import Outline from './Outline.astro';
type Props = { page: SiteEntry; toc: TocEntry[]; graphSection?: string | null; backlinks: GraphNode[] };
const { page, toc, graphSection = null, backlinks } = Astro.props;
// Each section's colour token (`graphColour` in site.config.ts), for scripts/graph.ts.
const colours = JSON.stringify(
  Object.fromEntries(
    Object.entries(site.collections).flatMap(([handle, c]) => (c.graphColour ? [[handle, c.graphColour]] : [])),
  ),
);
---

<div class="space-y-8 text-sm" data-pagefind-ignore>
  {/* This page and its neighbours one link away (scripts/graph.ts); gone when it has none. `graphSection` widens it to the whole section. */}
  <section data-graph={page.url} data-graph-section={graphSection ?? undefined} data-graph-colours={colours} hidden>
    <h2 class="text-heading mb-2 text-sm font-semibold lowercase">Graph</h2>
    <div class="relative">
      <canvas
        class="rounded-site border-rule bg-bg-elev block aspect-square w-full touch-none border bg-[radial-gradient(var(--color-rule-strong)_1px,transparent_1px)] bg-size-[16px_16px]"
        aria-label="Pages linked with this one"
        role="img"
        data-graph-canvas
      ></canvas>
      <GraphControls expand={true} />
    </div>
    <dialog
      class="rounded-site border-rule bg-bg text-fg backdrop:bg-fg/30 m-auto h-[min(85vh,48rem)] w-[min(92vw,72rem)] overflow-hidden border p-0 shadow-2xl backdrop:backdrop-blur-xs"
      closedby="any"
      aria-label="Graph"
      data-graph-dialog
    >
      <div class="relative h-full">
        <canvas
          class="block size-full touch-none bg-[radial-gradient(var(--color-rule-strong)_1px,transparent_1px)] bg-size-[16px_16px]"
          aria-label="Pages linked with this one, enlarged"
          role="img"
          data-graph-canvas
        ></canvas>
        <GraphControls expand={false} />
      </div>
    </dialog>
  </section>

  <Outline entries={toc} variant="rail" />

  {backlinks.length > 0 && (
    <section data-backlinks>
      <h2 class="text-heading mb-2 text-sm font-semibold lowercase">Linked from</h2>
      <ul class="space-y-1">
        {backlinks.map((b) => (
          <li>
            <a class="text-muted hover:text-fg inline-block py-0.5 no-underline pointer-coarse:py-1.5" href={b.url}>
              {b.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<script>
  import { initGraph } from '../scripts/graph.ts';
  initGraph();
</script>
