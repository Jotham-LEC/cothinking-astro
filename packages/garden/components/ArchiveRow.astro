---
// One row of an archive list, after `ls -l`: the entry's date in the display
// timezone (blank when undated), its title, then `note` (a publication's
// outlet).
import { day } from '../lib/dates.ts';
import { urlOf, type AstroEntry } from '../lib/load.ts';
type Props = { entry: AstroEntry; note?: string | null };
const { entry, note = null } = Astro.props;
const text = 'date' in entry.data ? day(entry.data.date) : null;
---

<li class="border-rule grid grid-cols-[6.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-b py-1.5">
  {text ? (
    <time class="text-muted font-sans text-[0.85em] tabular-nums" datetime={text}>
      {text}
    </time>
  ) : (
    <span></span>
  )}{' '}
  {/* Title and note as items of their own, not one run of text, so the link is not a link inside a sentence that only colour sets apart. */}
  <span class="flex min-w-0 flex-wrap items-baseline gap-x-[0.3em]">
    <a class="text-accent min-w-0" href={urlOf(entry)}>
      {entry.data.title}
    </a>
    {note && ' '}
    {note && <span class="text-muted font-sans text-[0.85em]">— {note}</span>}
  </span>
</li>
