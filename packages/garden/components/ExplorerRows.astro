---
// One level of the Explorer; includes itself for the children. A text-only
// folder is a button; the others are a link, plus a chevron when they have
// children. The `tree` lines are CSS, so a wrapped title keeps them whole;
// the script marks a closed folder `is-collapsed`.
import GithubSlugger from 'github-slugger';
import type { Row } from '../lib/explorer.ts';
import ChevronDown from '../assets/icons/chevron-down.svg';
type Props = { rows: Row[]; depth: number };
const { rows, depth } = Astro.props;
const slug = (title: string) => new GithubSlugger().slug(title);
---

<ul
  class:list={[
    'space-y-px',
    depth > 0 && 'group-[.is-collapsed]/folder:hidden',
    depth > 0 &&
      'mt-px ml-2.5 [&>li]:relative [&>li]:pl-3.5 [&>li]:before:absolute [&>li]:before:top-0 [&>li]:before:-bottom-px [&>li]:before:left-0 [&>li]:before:border-l [&>li]:before:border-subtle [&>li:last-child]:before:bottom-auto [&>li:last-child]:before:h-3.5 [&>li]:after:absolute [&>li]:after:top-3.5 [&>li]:after:left-0 [&>li]:after:w-2.5 [&>li]:after:border-t [&>li]:after:border-subtle',
  ]}
>
  {rows.map((row) => (
    <li
      class:list={['group/folder', { 'is-collapsed': row.children.length > 0 && !row.isOpen }]}
      data-path={row.url ?? `#${slug(row.title)}`}
    >
      <div class="flex items-center gap-1">
        {row.url && (
          <a
            href={row.url}
            class:list={[
              'min-w-0 flex-1 rounded-md px-2 py-1 leading-snug text-muted no-underline hover:bg-bg-elev hover:text-fg pointer-coarse:py-2',
              { 'font-semibold text-heading': row.kind !== 'page', 'bg-accent-soft text-heading': row.isCurrent },
            ]}
            aria-current={row.isCurrent ? 'page' : undefined}
          >
            {row.title}
          </a>
        )}
        {row.children.length > 0 && (
          <button
            type="button"
            class:list={[
              'flex shrink-0 items-center rounded-md hover:bg-bg-elev hover:text-fg',
              row.url
                ? 'size-7 justify-center text-subtle pointer-coarse:size-10'
                : 'min-w-0 flex-1 justify-between gap-2 px-2 py-1 text-left leading-snug font-semibold text-heading pointer-coarse:py-2',
            ]}
            aria-label={row.url ? `Toggle ${row.title}` : undefined}
            aria-expanded={row.isOpen ? 'true' : 'false'}
          >
            {!row.url && <span>{row.title}</span>}
            <ChevronDown
              class="size-3.5 transition-transform group-[.is-collapsed]/folder:-rotate-90"
              aria-hidden="true"
            />
          </button>
        )}
      </div>
      {row.children.length > 0 && <Astro.self rows={row.children} depth={depth + 1} />}
    </li>
  ))}
</ul>
