---
// The graph's buttons, over its top-right corner (scripts/graph.js wires them
// by their data attributes): zoom in, zoom out, and either open the graph
// larger (`expand`) or close the dialog it is in.
import ZoomIn from '../assets/icons/magnifying-glass-plus.svg';
import ZoomOut from '../assets/icons/magnifying-glass-minus.svg';
import Expand from '../assets/icons/arrows-pointing-out.svg';
import Close from '../assets/icons/x-mark.svg';
type Props = { expand: boolean };
const { expand } = Astro.props;
const buttons = [
  { attr: 'data-graph-zoom-in', label: 'Zoom in', Icon: ZoomIn },
  { attr: 'data-graph-zoom-out', label: 'Zoom out', Icon: ZoomOut },
  expand
    ? { attr: 'data-graph-expand', label: 'Open the graph larger', Icon: Expand }
    : { attr: 'data-graph-close', label: 'Close the graph', Icon: Close },
];
---

<div class="absolute top-2 right-2 flex gap-1">
  {buttons.map(({ attr, label, Icon }) => (
    <button
      type="button"
      class="rounded-site border-rule bg-bg/90 text-muted hover:text-fg hover:border-subtle flex size-7 items-center justify-center border backdrop-blur pointer-coarse:size-10"
      aria-label={label}
      title={label}
      {...{ [attr]: '' }}
    >
      <Icon class="size-4" />
    </button>
  ))}
</div>
