---
// How far down the page you are: the thin bar along the top at every
// width, and, outside a room from lg, a vim status line: the mode (CSS,
// styles/shell.css), the path, the layout's `statusline` and the scroll
// position in vim's words. The arrows are clip-paths, as the fonts have no
// powerline glyphs. Hidden from screen readers, as it repeats the page.
import ChevronLeft from '../assets/icons/chevron-left.svg';
import ChevronRight from '../assets/icons/chevron-right.svg';
type Props = { path: string; statusline?: string | null; room: boolean };
const { path, statusline = null, room } = Astro.props;
const segments = path.split('/').filter((part) => part !== '');
const arrow = '[clip-path:polygon(0_0,calc(100%_-_0.5rem)_0,100%_50%,calc(100%_-_0.5rem)_100%,0_100%)]';
---

<div class="fixed inset-x-0 top-0 z-50 h-0.5 print:hidden" aria-hidden="true" data-progress>
  <span class="bg-accent block h-full w-0"></span>
</div>

{!room && (
  <div
    class="bg-bg-elev border-rule text-muted fixed inset-x-0 bottom-0 z-30 hidden h-6 items-stretch border-t text-xs lg:flex"
    aria-hidden="true"
    data-pagefind-ignore
  >
    <span class:list={['bg-status-mode text-fg relative z-10 flex items-center pr-3.5 pl-2 font-semibold', arrow]} data-status-mode />
    <span
      class:list={['bg-button-bg text-button-fg -ml-2 flex min-w-0 items-center gap-1.5 pr-4 pl-4 font-semibold', arrow]}
    >
      <span>~</span>
      {segments.map((segment) => (
        <>
          <ChevronRight class="size-3 shrink-0" aria-hidden="true" />
          <span class="max-w-[40ch] truncate">{segment}</span>
        </>
      ))}
    </span>
    <span class="ml-auto flex items-center gap-2 pr-3 pl-4 tabular-nums">
      {statusline && (
        <>
          <ChevronLeft class="text-subtle size-3 shrink-0" aria-hidden="true" />
          <span>{statusline}</span>
        </>
      )}
    </span>
    <span
      class="bg-muted text-bg flex min-w-[6ch] items-center justify-end pr-2 pl-4 font-semibold tabular-nums [clip-path:polygon(0.5rem_0,100%_0,100%_100%,0.5rem_100%,0_50%)]"
      data-status-scroll
    />
  </div>
)}

<script>
  import { initProgress } from '../scripts/progress.ts';
  initProgress();
</script>
