---
// `~/` `Section/` breadcrumbs up to the current page's parent (`parents`).
import { parents } from '../lib/breadcrumbs.ts';
import { garden } from '../lib/load.ts';
type Props = { url: string };
const crumbs = parents(Astro.props.url, (await garden()).live);
// Every crumb a chip in the accent, so each reads as a link; together they spell a shell's path, `~/` for home.
const chip =
  'rounded-site border-rule bg-bg-elev text-accent hover:border-accent hover:text-accent-hover inline-flex items-center border px-1.5 py-px font-mono text-xs leading-5 font-semibold no-underline pointer-coarse:px-2.5 pointer-coarse:py-1.5';
---

<nav class="mb-4 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb" data-pagefind-ignore>
  {crumbs.map((crumb, i) =>
    i === 0 ? (
      <a class={chip} href={crumb.url} aria-label="Home" title="Home">
        ~/
      </a>
    ) : (
      <a class={chip} href={crumb.url}>
        {crumb.title}
        <span aria-hidden="true">/</span>
      </a>
    ),
  )}
</nav>
