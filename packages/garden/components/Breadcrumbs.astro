---
// `~ / Section` breadcrumbs up to the current page's parent (`parents`).
import { parents } from '../lib/breadcrumbs.ts';
import type { SiteEntry } from '../lib/entry.ts';
type Props = { url: string; live: SiteEntry[] };
const { url, live } = Astro.props;
const crumbs = parents(url, live);
---

<nav class="text-muted mb-4 flex flex-wrap items-center gap-x-1.5 text-sm" aria-label="Breadcrumb" data-pagefind-ignore>
  {crumbs.map((crumb, i) => {
    const first = i === 0;
    return (
      <>
        {!first && (
          <Fragment>
            {' '}
            <span class="text-subtle" aria-hidden="true">
              /
            </span>{' '}
          </Fragment>
        )}
        {first ? (
          <a
            class="hover:text-fg -mx-2 inline-flex min-w-6 justify-center px-2 pointer-coarse:py-2"
            href={crumb.url}
            aria-label="Home"
          >
            ~
          </a>
        ) : (
          <a class="hover:text-fg pointer-coarse:py-2" href={crumb.url}>
            {crumb.title}
          </a>
        )}
      </>
    );
  })}
</nav>
