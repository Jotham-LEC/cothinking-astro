---
// An entry's page inside the site shell: breadcrumbs, title, outline, body,
// pager and the rail. `entry` is one of Astro's content entries (any
// collection). Slots: `after-title` (under the title: a subtitle, a
// byline), `before-body` and `after-body` (inside the text),
// `after-article`, and `body`, markup in place of the Markdown body; the
// default slot is the rendered body; `head` goes into the <head>.
// `extraHeadings` are headings for the outline that the body lacks (a view's
// own h2s). `path` is the address when it is not the entry's own (/notes/2);
// such a page passes `seoTitle` for its own title, and `searchable={false}`
// so the search index holds the entry's text once.
import { garden, site } from '../lib/load.ts';
import { pageInfo } from '../lib/info.ts';
import { backlinks } from '../lib/graph.ts';
import { pager } from '../lib/pager.ts';
import { toc, type Heading, type TocEntry } from '../lib/toc.ts';
import { day } from '../lib/dates.ts';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Outline from './Outline.astro';
import PageHeader from './PageHeader.astro';
import Prose from './Prose.astro';
import Rail from './Rail.astro';

type Props = {
  entry: { collection: string; id: string };
  path?: string;
  headings?: Heading[];
  extraHeadings?: TocEntry[];
  seoTitle?: string;
  searchable?: boolean;
};
const { headings = [], extraHeadings = [], seoTitle, searchable = true } = Astro.props;
const g = await garden();
const page = g.entry(Astro.props.entry);
const path = Astro.props.path ?? page.url;
const info = pageInfo(page, site);
const entries = toc(headings, extraHeadings);
const neighbours = pager(page, g.live, site);
const linked = backlinks(g.graph, page);
const updated = page.updated ?? page.date;
const section = info.section ? (site.collections[info.section]?.title ?? info.section) : null;
---

<Layout
  entry={Astro.props.entry}
  info={info}
  path={path}
  seoTitle={seoTitle}
  statusline={info.readTime ? `${info.readTime} min read` : null}
>
  <slot name="head" slot="head" />
  {!info.isHome && <Breadcrumbs url={path} />}

  <div
    data-pagefind-body={searchable ? '' : undefined}
    data-pagefind-meta={searchable && section ? `section:${section}` : undefined}
  >
    <PageHeader title={page.title} eyebrow={info.eyebrow} source={info.source} sourceDate={info.sourceDate} popover />
    <slot name="after-title" />
    <Outline entries={entries} variant="details" />

    {Astro.slots.has('body') ? (
      <article>
        <slot name="body" />
      </article>
    ) : (
      <Prose as="article" data-popover>
        <slot name="before-body" />
        <slot />
        <slot name="after-body" />
      </Prose>
    )}
  </div>

  {/* The pages either side: a series' parts, or the notes by date. */}
  {(neighbours.previous || neighbours.next) && (
    <nav class="mt-10 grid gap-3 font-sans text-sm sm:grid-cols-2" aria-label="Previous and next" data-pagefind-ignore>
      {(
        [
          ['prev', neighbours.previous],
          ['next', neighbours.next],
        ] as const
      ).map(
        ([rel, neighbour]) =>
          neighbour && (
            <a
              class:list={[
                'rounded-site border-rule hover:border-accent group block border px-4 py-3 no-underline',
                { 'sm:col-start-2 sm:text-right': rel === 'next' },
              ]}
              href={neighbour.url}
              rel={rel}
            >
              <span class="text-muted block text-xs">{rel === 'prev' ? '← Previous' : 'Next →'}</span>{' '}
              <span class="text-heading group-hover:text-accent font-semibold">{neighbour.title}</span>
            </a>
          ),
      )}
    </nav>
  )}

  <slot name="after-article" />

  {/* A note's date is in its eyebrow; a saved edit to it is not news. */}
  {!info.isNote && updated && (
    <p class="border-rule text-muted mt-10 border-t pt-5 text-sm">Last updated {day(updated)}</p>
  )}

  <Rail slot="rail" page={page} toc={entries} graphSection={info.graphSection} backlinks={linked} />
</Layout>
