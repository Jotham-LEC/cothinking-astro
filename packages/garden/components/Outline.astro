---
// The page's outline (lib/toc.ts): folded under the title where there is
// no rail for it (`details`), or the rail's list (`rail`). The script
// lights the heading in view in both.
import type { TocEntry } from '../lib/toc.ts';
import ChevronDown from '../assets/icons/chevron-down.svg';
type Props = { entries: TocEntry[]; variant: 'details' | 'rail' };
const { entries, variant } = Astro.props;
---

{entries.length > 0 && variant === 'details' && (
  <details class="group rounded-site border-rule bg-bg-elev mb-8 border text-sm xl:hidden" data-toc data-pagefind-ignore>
    <summary class="text-heading flex cursor-pointer items-center gap-2 px-4 py-2.5 font-medium marker:content-none">
      <span>On this page</span>
      <span class="bg-accent-soft text-accent rounded-full px-2 text-xs">{entries.length}</span>
      <ChevronDown class="text-subtle ml-auto size-4 transition-transform group-open:rotate-180" aria-hidden="true" />
    </summary>
    <ul class="border-rule space-y-1 border-t px-4 py-3">
      {entries.map((heading) => (
        <li class:list={{ 'pl-4': heading.level !== 2 }}>
          <a
            class="text-muted hover:text-fg [&.is-active]:text-accent inline-block py-0.5 no-underline pointer-coarse:py-1.5"
            href={`#${heading.id}`}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

{entries.length > 0 && variant === 'rail' && (
  <div class="hidden xl:block" data-toc>
    <h2 class="text-heading mb-2 text-sm font-semibold lowercase">On this page</h2>
    <ul class="border-rule space-y-1 border-l">
      {entries.map((heading) => (
        <li>
          <a
            href={`#${heading.id}`}
            class:list={[
              '-ml-px block border-l border-transparent py-0.5 text-muted no-underline hover:text-fg [&.is-active]:text-accent',
              heading.level === 2 ? 'pl-3' : 'pl-6',
            ]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<script>
  import { initOutline } from '../scripts/outline.ts';
  initOutline();
</script>
