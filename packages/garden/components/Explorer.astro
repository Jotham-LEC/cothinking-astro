---
// The Explorer: the whole site as one tree (lib/explorer.ts). Folders are
// closed unless they hold the current page; the script remembers what you
// open, keeps the scroll position between pages, and focuses the current
// page's link when the drawer opens.
import type { Row } from '../lib/explorer.ts';
import ExplorerRows from './ExplorerRows.astro';
type Props = { rows: Row[] };
const { rows } = Astro.props;
---

<nav aria-label="Explorer" class="text-sm" data-pagefind-ignore>
  <ExplorerRows rows={rows} depth={0} />
</nav>

<script>
  import { initExplorer } from '../scripts/explorer.ts';
  initExplorer();
</script>
