---
// Rendered Markdown: the typography plugin with this site's element
// modifiers (`as` is the wrapping tag), and the behaviours of the text:
// hover previews of its links, images that enlarge, headings that copy their
// address, code blocks that copy, tabs (`:::tabs`) that switch.
import type { Polymorphic } from 'astro/types';
type Props<Tag extends 'div' | 'article' | 'section' = 'div'> = Polymorphic<{ as: Tag }>;
const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={[
    'prose max-w-none font-prose wrap-break-word',
    'prose-headings:scroll-mt-24 prose-headings:font-heading prose-headings:font-extrabold prose-headings:text-balance',
    'prose-p:text-pretty prose-li:text-pretty prose-blockquote:text-pretty',
    'prose-a:hover:text-accent-hover',
    'prose-code:wrap-anywhere prose-code:before:content-none prose-code:after:content-none',
    'prose-table:block prose-table:overflow-x-auto',
    'prose-img:rounded-site prose-img:border prose-img:border-rule',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>

<script>
  import { initCodeCopy } from '../scripts/code-copy.ts';
  import { initHeadingLinks } from '../scripts/heading-links.ts';
  import { initPopovers } from '../scripts/popovers.ts';
  import { initTabs } from '../scripts/tabs.ts';
  import { initZoom } from '../scripts/zoom.ts';
  initCodeCopy();
  initHeadingLinks();
  initPopovers();
  initTabs();
  initZoom();
</script>
