---
// Title, meta tags and JSON-LD for a page (`head`: lib/seo.ts), the favicon
// and the feeds.
import { jsonLd, type Head } from '../lib/seo.ts';
import type { SiteConfig } from '../lib/site.ts';
type Props = { head: Head; site: SiteConfig; feed: { title: string; url: string } | null };
const { head: h, site, feed } = Astro.props;
const ld = jsonLd(h.graph);
---

<title>{h.title}</title>
{h.description && <meta name="description" content={h.description} />}
<meta name="robots" content={h.robots} />
{h.canonical && <link rel="canonical" href={h.canonical} />}
<meta property="og:type" content={h.ogType} />
<meta property="og:title" content={h.ogTitle} />
{h.description && <meta property="og:description" content={h.description} />}
<meta property="og:url" content={h.url} />
<meta property="og:site_name" content={h.siteName} />
<meta property="og:locale" content={h.locale} />
{h.image && (
  <>
    <meta property="og:image" content={h.image.url} />
    <meta property="og:image:width" content={String(h.image.width)} />
    <meta property="og:image:height" content={String(h.image.height)} />
    {h.image.alt && <meta property="og:image:alt" content={h.image.alt} />}
  </>
)}
{h.published && <meta property="article:published_time" content={h.published} />}
{h.modified && <meta property="article:modified_time" content={h.modified} />}
<meta name="twitter:card" content={h.image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={h.ogTitle} />
{h.description && <meta name="twitter:description" content={h.description} />}
{h.image && (
  <>
    <meta name="twitter:image" content={h.image.url} />
    {h.image.alt && <meta name="twitter:image:alt" content={h.image.alt} />}
  </>
)}
{ld && <script type="application/ld+json" set:html={ld} />}
<meta name="author" content={site.name} />
<link href={site.favicon} rel="icon" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={site.name} href={`${site.url}/feed.xml`} />
{feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={`${site.url}${feed.url}`} />}
