---
// The site shell: the head, the header, the Explorer (a drawer below lg, a column from there), the page, the `rail`
// slot, the palette, the keys card, the status line and the footer. Slots: default (the page), `rail`, `head`.
import { Font } from 'astro:assets';
import { garden, site, type AstroEntry } from '../lib/load.ts';
import type { PageInfo } from '../lib/pageInfo.ts';
import { headerLinks, markCurrent, menu, panels, footerColumns } from '../lib/explorer.ts';
import { seoFor } from '../lib/seo.ts';
import Drawer from '../components/Drawer.astro';
import Footer from '../components/Footer.astro';
import Gtm from '../components/Gtm.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Keys from '../components/Keys.astro';
import Palette from '../components/Palette.astro';
import Statusline from '../components/Statusline.astro';
import '@site/styles/site.css';

type Props = {
  /** One of Astro's entries, for an entry's page; omit it for a page without one (the 404). */
  entry?: AstroEntry | null;
  /** `pageInfo()` of the entry (Entry passes it): the section's feed. */
  info?: PageInfo | null;
  /** The page's address. Never `Astro.url`: `build.format: 'file'` makes that `/x.html`. */
  path: string;
  /** Full width, no Explorer column and no rail; its whole <main> goes into the search index. */
  room?: boolean;
  /** Head overrides: a title (also renames an entry's later pages), a description, noindex, the HTTP status. */
  seo?: { title?: string; description?: string; noindex?: boolean; status?: number };
  /** The status line's text. */
  statusline?: string | null;
};
const { entry = null, info = null, path, room = false, seo = {}, statusline = null } = Astro.props;
const { siteEntryOf, live, explorer } = await garden();
const page = entry ? siteEntryOf(entry) : null;
const head = seoFor(site, live, {
  page,
  path,
  status: seo.status ?? 200,
  title: seo.title,
  description: seo.description,
  noindex: seo.noindex,
});
const { hasExplorer, hasDrawer } = panels(live, site, room);
const rows = hasExplorer ? markCurrent(explorer, page, path) : [];
const links = headerLinks(live, site, path);
const hasRail = Astro.slots.has('rail') && !room;
// Google Tag Manager, in production builds only.
const gtmId = import.meta.env.PROD ? (site.marketing.gtmId ?? null) : null;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gtmId && <Gtm id={gtmId} part="head" />}
    <Head head={head} feed={info?.feedUrl ? { title: info.feedTitle!, url: info.feedUrl } : null} />
    <slot name="head" />
    {/* Before first paint: the chosen theme, and the panels put away last time (reader mode). */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
          ['explorer', 'rail'].forEach(function (panel) {
            if (localStorage.getItem('hide-' + panel) === 'on')
              document.documentElement.setAttribute('data-hide-' + panel, '');
          });
        } catch (e) {}
      })();
    </script>
    {/* The fonts (garden/config.mjs); the upright faces the first screen is set in are preloaded. */}
    <Font cssVariable="--font-aporetic-sans" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-source-serif" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-aporetic-mono" />
  </head>
  <body class:list={['min-h-screen font-sans antialiased', { 'bg-terminal': room }]}>
    {gtmId && <Gtm id={gtmId} part="body" />}
    <a
      class="bg-button-bg text-button-fg fixed top-2 left-2 z-100 -translate-y-[200%] rounded-lg px-3.5 py-2 font-semibold focus-visible:translate-y-0"
      href="#main"
    >
      Skip to content
    </a>

    <Header room={room} hasExplorer={hasExplorer} hasDrawer={hasDrawer} links={links} />

    <div class="shell" data-room={room ? '' : undefined}>
      {hasDrawer && <Drawer rows={rows} menu={menu(live, site, path, rows)} room={room} />}

      {room ? (
        <main id="main" tabindex="-1" class="py-10 focus:outline-none sm:py-14" data-pagefind-body>
          <slot />
        </main>
      ) : (
        <div class="min-w-0 py-8 lg:py-10">
          <main id="main" tabindex="-1" class="mx-auto max-w-[72ch] focus:outline-none">
            <slot />
          </main>
        </div>
      )}
      {hasRail && (
        <aside id="rail">
          <div class="xl:h-full xl:overflow-y-auto xl:py-10 xl:pl-6">
            <slot name="rail" />
          </div>
        </aside>
      )}
    </div>

    <Palette live={live} />
    <Keys />
    <Statusline path={path} statusline={statusline} room={room} />
    <Footer columns={footerColumns(live, site)} text={site.footerText} room={room} />
  </body>
</html>
