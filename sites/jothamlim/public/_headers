# Response headers for Cloudflare static assets (read at deploy, not served).
# Vite names /_astro/ files by their content, so a browser can keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers on every response. No CSP yet: GTM and the inline scripts would need hashes.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
