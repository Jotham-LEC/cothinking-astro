// The jothamlim Worker: only static assets, the site's dist/ (npm run build -w sites/jothamlim).
// Deploy with npm run deploy -w sites/jothamlim. 404.html answers a missing page with a 404;
// addresses have no trailing slash, as Caddy served them.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jothamlim",
  // The owner's account (the key also reaches clients' accounts, so never leave this out).
  "account_id": "f89b94f04c7ad8999c9dcc3afea694eb",
  "compatibility_date": "2026-10-22",
  // Served at jothamlim.com (a Custom Domain: Cloudflare keeps its DNS record and certificate).
  "routes": [{ "pattern": "jothamlim.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
}
