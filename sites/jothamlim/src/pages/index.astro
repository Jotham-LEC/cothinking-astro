---
// The home page: what you write on the page, then the newest pages across every section.
import { getEntry, render } from 'astro:content';
import Entry from '@garden/components/Entry.astro';
import ArchiveRow from '@garden/components/ArchiveRow.astro';
import HeadingLink from '@garden/components/HeadingLink.astro';
import { latest as newest } from '@site/lib/listing.ts';
const home = (await getEntry('pages', 'home'))!;
const { Content, headings } = await render(home);
const latest = await newest(5);
---

<Entry entry={home} headings={headings} extraHeadings={[{ level: 2, id: 'latest', text: 'Latest' }]}>
  <Content />
  <Fragment slot="after-body">
    <h2 id="latest">
      <HeadingLink id="latest" title="Latest" />
    </h2>
    <ul class="not-prose list-none p-0">
      {latest.map((entry) => (
        <ArchiveRow entry={entry} />
      ))}
    </ul>
  </Fragment>
</Entry>
