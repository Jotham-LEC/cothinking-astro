---
// /notes/type/{type}: the stream narrowed to one post type; only a type with
// a published note gets a listing. Not indexed: /notes lists the same notes.
import { getEntry } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '@garden/layouts/Layout.astro';
import Breadcrumbs from '@garden/components/Breadcrumbs.astro';
import PageHeader from '@garden/components/PageHeader.astro';
import Stream from '@site/components/Stream.astro';
import { newestFirst } from '@site/lib/listing.ts';
import { site } from '@site/site.config.ts';

export const getStaticPaths = (async ({ paginate }) => {
  const notes = await newestFirst('notes');
  return Object.entries(site.collections.notes.types).flatMap(([handle, title]) => {
    const own = notes.filter((n) => n.data.type === handle);
    return own.length ? paginate(own, { pageSize: 20, params: { type: handle }, props: { title } }) : [];
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, title } = Astro.props;
const landing = (await getEntry('pages', 'notes'))!;
const path = page.url.current;
---

<Layout
  path={path}
  seo={{
    title: `${title} notes`,
    description: `Every ${title.toLowerCase()} note, newest first.`,
    noindex: true,
  }}
>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs url={path} />
  <PageHeader title={title} eyebrow={landing.data.title} />
  <Stream page={page} />
</Layout>
