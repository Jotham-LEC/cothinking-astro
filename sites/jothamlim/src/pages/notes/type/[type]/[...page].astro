---
// /notes/type/{type}: the stream narrowed to one post type; only a type with
// a published note gets a listing.
import { getEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { garden } from '@garden/lib/load.ts';
import { byDateDesc } from '@garden/lib/entry.ts';
import { noteTypesInUse } from '@garden/lib/explorer.ts';
import Layout from '@garden/layouts/Layout.astro';
import Breadcrumbs from '@garden/components/Breadcrumbs.astro';
import PageHeader from '@garden/components/PageHeader.astro';
import Stream from '@site/components/Stream.astro';
import { site } from '@site/site.config.ts';

export const getStaticPaths = (async ({ paginate }) => {
  const g = await garden();
  return noteTypesInUse(g.live, 'notes', site.collections.notes.types).flatMap(([handle, title]) =>
    paginate(byDateDesc(g.live.filter((p) => p.collection === 'notes' && p.type === handle)), {
      pageSize: 20,
      params: { type: handle },
      props: { title },
    }),
  );
}) satisfies GetStaticPaths;

const { page, title } = Astro.props;
const g = await garden();
const landing = (await getEntry('pages', 'notes'))!;
const path = page.currentPage > 1 ? `/notes/type/${Astro.params.type}/${page.currentPage}` : `/notes/type/${Astro.params.type}`;
---

<Layout path={path} seoTitle={`${title} notes`} seoDescription={`Every ${title.toLowerCase()} note, newest first.`}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs url={path} live={g.live} currentCrumb />
  <PageHeader title={title} eyebrow={landing.data.title} />
  <Stream page={page} />
</Layout>
