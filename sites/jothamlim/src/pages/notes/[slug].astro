---
// A single note: the post's text, its pictures, and where it lives on
// Mastodon. Its id is its date and minute, never only digits, so none
// collides with /notes/2 (garden/lib/mastodon.ts).
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import Entry from '@garden/components/Entry.astro';
import NoteMedia from '@site/components/NoteMedia.astro';
import NoteSource from '@site/components/NoteSource.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', (n) => !n.data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Entry entry={entry} headings={headings}>
  <Content />
  <div slot="after-body" class="flex flex-col gap-4">
    <NoteMedia media={entry.data.media} eager />
    <NoteSource note={entry} />
  </div>
</Entry>
