---
// /notes and /notes/2, /notes/3…: the landing page's
// text, then the stream, 20 to a page, newest first. From page 2 the head
// says which page it is, and the search index skips the repeated text.
import { getEntry, render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Entry from '@garden/components/Entry.astro';
import Stream from '@site/components/Stream.astro';
import { newestFirst } from '@site/lib/listing.ts';

export const getStaticPaths = (async ({ paginate }) =>
  paginate(await newestFirst('notes'), { pageSize: 20 })) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props;
const landing = (await getEntry('pages', 'notes'))!;
const { Content, headings } = await render(landing);
const first = page.currentPage === 1;
---

<Entry
  entry={landing}
  path={page.url.current}
  headings={headings}
  seo={first ? undefined : { title: `${landing.data.title}, page ${page.currentPage}` }}
  searchable={first}
>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Content />
  <Stream slot="after-article" page={page} />
</Entry>
