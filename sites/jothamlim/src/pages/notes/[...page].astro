---
// /notes (template `notes/index`) and /notes/2, /notes/3…: the landing page's
// text, then the stream, 20 to a page, newest first.
import { getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { garden } from '@garden/lib/load.ts';
import { byDateDesc } from '@garden/lib/entry.ts';
import Entry from '@garden/components/Entry.astro';
import Stream from '@site/components/notes/Stream.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const g = await garden();
  const notes = byDateDesc(g.live.filter((p) => p.collection === 'notes'));
  return paginate(notes, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const landing = (await getEntry('pages', 'notes'))!;
const { Content, headings } = await render(landing);
---

<Entry entry={landing} path={page.url.current} headings={headings}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Content />
  <Stream slot="after-article" page={page} />
</Entry>
