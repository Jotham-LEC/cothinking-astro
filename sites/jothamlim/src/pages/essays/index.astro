---
// /essays: the landing page's text, then every essay newest first.
import { getEntry, render } from 'astro:content';
import Entry from '@garden/components/Entry.astro';
import ArchiveRow from '@garden/components/ArchiveRow.astro';
import { newestFirst } from '@site/lib/listing.ts';
const landing = (await getEntry('pages', 'essays'))!;
const { Content, headings } = await render(landing);
const listing = await newestFirst('essays');
---

<Entry entry={landing} headings={headings}>
  <Content />
  <ul slot="after-body" class="not-prose list-none p-0" data-archive>
    {listing.map((piece) => (
      <ArchiveRow entry={piece} />
    ))}
  </ul>
</Entry>
