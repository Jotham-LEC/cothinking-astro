---
// /publications: the landing page's text, then the archive by year, newest
// first, each piece with its outlet.
import { getEntry, render } from 'astro:content';
import { year } from '@garden/lib/dates.ts';
import Entry from '@garden/components/Entry.astro';
import ArchiveRow from '@garden/components/ArchiveRow.astro';
import { newestFirst } from '@site/lib/listing.ts';
import { outlets } from '@site/site.config.ts';
const landing = (await getEntry('pages', 'publications'))!;
const { Content, headings } = await render(landing);
// By year (in the display timezone), newest first.
const archive = [...Map.groupBy(await newestFirst('publications'), (p) => year(p.data.date))];
---

<Entry entry={landing} headings={headings}>
  <Content />
  <Fragment slot="after-body">
    {archive.map(([y, pieces]) => (
      <>
        <h2 id={y}>{y}</h2>
        <ul class="not-prose list-none p-0" data-archive>
          {pieces.map((piece) => (
            <ArchiveRow entry={piece} note={outlets[piece.data.outlet as keyof typeof outlets]} />
          ))}
        </ul>
      </>
    ))}
  </Fragment>
</Entry>
