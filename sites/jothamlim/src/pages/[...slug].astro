---
// The pages collection (career, cv, sports) and the section landing pages, by
// template: `default`, `section` (the mounted collection newest first),
// `publications` (the archive by year). Home is index.astro; the notes
// landing page is notes/[...page].astro, as it paginates.
import { getCollection, render } from 'astro:content';
import { garden } from '@garden/lib/load.ts';
import { byYear, childrenOf, mountedOn } from '@garden/lib/entry.ts';
import Entry from '@garden/components/Entry.astro';
import ArchiveRow from '@garden/components/ArchiveRow.astro';
import { outlets } from '@site/site.config.ts';
import { urlOf } from '@site/lib/urls.ts';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !p.data.draft && p.id !== 'home' && p.data.template !== 'notes/index');
  return pages.map((entry) => ({ params: { slug: urlOf('pages', entry.id).slice(1) }, props: { entry } }));
}
const { entry } = Astro.props;
const g = await garden();
const page = g.entry(entry);
const { Content, headings } = await render(entry);
const mount = mountedOn(page, g.site);
const listing = entry.data.template === 'section' && mount ? childrenOf(mount, g.live, g.site) : [];
// The publications archive: each piece's outlet comes from its own entry.
const outletOf = new Map(
  (await getCollection('publications')).map((p) => [p.id, outlets[p.data.outlet as keyof typeof outlets]]),
);
const archive = entry.data.template === 'publications' ? byYear(childrenOf('publications', g.live, g.site)) : [];
---

<Entry entry={entry} headings={headings}>
  <Content />
  <Fragment slot="after-body">
    {listing.length > 0 && (
      <ul class="not-prose list-none p-0" data-archive>
        {listing.map((piece) => (
          <ArchiveRow date={piece.date} url={piece.url} title={piece.title} />
        ))}
      </ul>
    )}
    {archive.map(([year, pieces]) => (
      <>
        <h2 id={year}>{year}</h2>
        <ul class="not-prose list-none p-0" data-archive>
          {pieces.map((piece) => (
            <ArchiveRow date={piece.date} url={piece.url} title={piece.title} note={outletOf.get(piece.id)} />
          ))}
        </ul>
      </>
    ))}
  </Fragment>
</Entry>
