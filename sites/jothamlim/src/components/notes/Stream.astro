---
// One page of the stream: the cards (one eager image among them), then
// newer/older links from Astro's paginate().
import type { Page as Paginated } from 'astro';
import type { SiteEntry } from '@garden/lib/entry.ts';
import Card from './Card.astro';
import OneEagerImage from './OneEagerImage.astro';
type Props = { page: Paginated<SiteEntry> };
const { page } = Astro.props;
---

<div class="mt-8 flex flex-col gap-6" data-stream>
  {page.data.length > 0 ? (
    <OneEagerImage>
      {page.data.map((note) => (
        <Card note={note} />
      ))}
    </OneEagerImage>
  ) : (
    <p class="text-muted mt-6 text-sm">Nothing here yet.</p>
  )}
</div>

{page.lastPage > 1 && (
  <nav class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="Older and newer notes">
    {page.url.prev && (
      <a
        class="rounded-site border-rule hover:border-rule-strong flex flex-col border px-4 py-3 text-sm no-underline"
        href={page.url.prev}
      >
        <span class="text-muted text-xs tracking-wider uppercase">Newer</span>
        <span class="text-heading font-medium">Page {page.currentPage - 1}</span>
      </a>
    )}
    {page.url.next && (
      <a
        class="rounded-site border-rule hover:border-rule-strong flex flex-col border px-4 py-3 text-right text-sm no-underline sm:col-start-2"
        href={page.url.next}
      >
        <span class="text-muted text-xs tracking-wider uppercase">Older</span>
        <span class="text-heading font-medium">Page {page.currentPage + 1}</span>
      </a>
    )}
  </nav>
)}
