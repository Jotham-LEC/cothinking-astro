---
// Its content with one eager image at most, as a single rendered page had:
// rehype-images makes the first image of each rendered body eager with a
// high fetch priority, so on the stream every card's would be. The first
// stays; every later one becomes lazy.
let first = true;
const html = (await Astro.slots.render('default')).replace(/<img\b[^>]*>/g, (tag) => {
  if (!tag.includes(' loading="eager"')) return tag;
  if (first) {
    first = false;
    return tag;
  }
  return tag.replace(' loading="eager"', ' loading="lazy"').replace(' fetchpriority="high"', '');
});
---

<Fragment set:html={html} />
