---
// One note in the stream: a date badge linking to the note, the type icon
// linking to that type's listing, then the post.
import { render, type CollectionEntry } from 'astro:content';
import { badge, longDate } from '@garden/lib/dates.ts';
import { urlOf } from '@garden/lib/load.ts';
import Prose from '@garden/components/Prose.astro';
import { site } from '@site/site.config.ts';
import Icon from './Icon.astro';
import Quote from './Quote.astro';
type Props = { note: CollectionEntry<'notes'> };
const { note } = Astro.props;
const { type, title, quote, cite, date } = note.data;
const typeTitle = site.collections.notes.types[type as keyof typeof site.collections.notes.types] ?? type;
const url = urlOf(note);
const posted = badge(date);
const { Content } = await render(note);
const hasContent = (note.body ?? '').trim() !== '';
---

<article class="grid gap-4 sm:grid-cols-[3.5rem_minmax(0,1fr)]" data-type={type} aria-label={title}>
  <div class="flex items-center justify-between sm:flex-col sm:justify-start sm:gap-3 sm:pt-2">
    <a
      class="text-fg hover:text-accent flex items-baseline gap-1.5 leading-none uppercase no-underline sm:flex-col sm:items-center sm:gap-0"
      href={url}
      aria-label={`${title}, ${longDate(date)}`}
    >
      <span class="text-xs tracking-[0.12em]" data-month>
        {posted.month}
      </span>
      <span class="text-base font-extrabold sm:text-3xl">{posted.day}</span>
    </a>
    <a
      class="text-muted hover:text-accent block size-6"
      href={`/notes/type/${type}`}
      aria-label={`All ${typeTitle.toLowerCase()} notes`}
    >
      <Icon type={type} />
    </a>
  </div>
  <div class="rounded-site border-rule bg-bg-elev overflow-hidden border">
    {type === 'quote' && <Quote quote={quote ?? ''} cite={cite} />}
    {(type === 'text' || hasContent) && (
      <div class="px-6 py-5">
        {type === 'text' && (
          <h2 class="text-heading font-heading mb-4 text-xl font-extrabold" data-note-title>
            <a class="hover:text-accent no-underline" href={url}>
              {title}
            </a>
          </h2>
        )}
        {/* A heading in a note stays under the card's title in size. */}
        <Prose class="prose-h2:mt-7 prose-h2:text-xl">
          <Content />
        </Prose>
      </div>
    )}
  </div>
</article>
