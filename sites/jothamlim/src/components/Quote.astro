---
// The quote, large, as plain text; the rule under it separates it from the
// note's text, when there is any.
type Props = { quote: string; cite?: string | null };
const { quote, cite = null } = Astro.props;
---

<blockquote class="border-rule text-fg font-prose m-0 border-0 border-b px-6 py-7 text-2xl leading-snug font-bold italic last:border-b-0">
  <p>{quote}</p>
  {cite && <cite class="text-muted mt-3 block font-sans text-base font-medium not-italic">— {cite}</cite>}
</blockquote>
