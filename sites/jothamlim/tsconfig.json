{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "../../packages/garden/**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@garden/*": [
        "../../packages/garden/*"
      ],
      "@site/*": [
        "./src/*"
      ]
    }
  }
}
