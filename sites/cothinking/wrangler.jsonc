// The cothinking Worker: only static assets, the site's dist/ (npm run build:cothinking).
// Deploy with npm run deploy:cothinking. 404.html answers a missing page with a 404;
// addresses have no trailing slash, as Caddy served them.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cothinking",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
}
