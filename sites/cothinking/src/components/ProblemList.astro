---
// The problems I fix, one linked row each; `withLine` adds `what_i_do`. Titles
// look like headings but are not, or the outline would repeat the list.
import type { CollectionEntry } from 'astro:content';
import { urlOf } from '@garden/lib/load.ts';
type Props = { problems: CollectionEntry<'problems'>[]; withLine?: boolean };
const { problems, withLine = false } = Astro.props;
---

<ul class="border-rule divide-rule mt-8 divide-y border-y font-sans">
  {problems.map((problem) => (
    <li>
      <a class="group hover:bg-bg-elev block px-2 py-4 no-underline" href={urlOf(problem)}>
        <span class="text-heading group-hover:text-accent font-heading text-lg font-extrabold">
          <span class="text-accent mr-2" aria-hidden="true">
            →
          </span>
          {problem.data.title}
        </span>
        {withLine && problem.data.what_i_do && (
          <span class="text-muted mt-1 block text-sm">{problem.data.what_i_do}</span>
        )}
      </a>
    </li>
  ))}
</ul>
