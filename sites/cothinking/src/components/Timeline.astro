---
// Steps as a timeline (each `title` and `text`): down the page on a phone,
// across it from md (unless `vertical`, for a narrow reading column), joined
// by a line through numbered dots.
type Props = { steps: { title: string; text: string }[]; vertical?: boolean };
const { steps, vertical = false } = Astro.props;
const across = !vertical;
---

<ol
  class:list={[
    'relative mt-10 grid gap-8 md:gap-6',
    'before:bg-rule before:absolute before:top-0 before:bottom-0 before:left-4 before:w-px',
    {
      'md:before:top-4 md:before:right-0 md:before:bottom-auto md:before:left-0 md:before:h-px md:before:w-full':
        across,
      'md:grid-cols-3': across && steps.length === 3,
      'md:grid-cols-4': across && steps.length === 4,
      'md:grid-cols-5': across && steps.length === 5,
    },
  ]}
>
  {steps.map((step, i) => (
    <li class:list={['relative pl-12', { 'md:pl-0': across }]}>
      <span
        class:list={[
          'bg-button-bg text-button-fg absolute top-0 left-0 flex size-8 items-center justify-center rounded-full font-sans text-sm font-bold',
          { 'md:relative': across },
        ]}
        aria-hidden="true"
      >
        {i + 1}
      </span>
      <h3 class:list={['text-heading mt-0 font-sans text-base font-bold', { 'md:mt-4': across }]}>{step.title}</h3>
      <p class="text-muted mt-1 text-sm">{step.text}</p>
    </li>
  ))}
</ol>
