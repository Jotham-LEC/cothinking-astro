---
// The Work page (`cothinking/work`): its introduction, written here, then the
// work collection as tiles in its order.
import { wiki } from '@garden/lib/load.ts';
import { childrenOf } from '@garden/lib/pages.ts';
import type { LivePage } from '@garden/lib/types.ts';
import Entry from '@garden/components/Entry.astro';
import Prose from '@garden/components/Prose.astro';
import NextStep from '@site/components/cothinking/NextStep.astro';
import WorkTiles from '@site/components/cothinking/WorkTiles.astro';
type Props = { page: LivePage };
const { page } = Astro.props;
const w = await wiki();
---

<Entry page={page}>
  <Fragment slot="body">
    <Prose>
      <p>
        Websites I have built, all of them live. I built the Innov8tif and Pixaproof sites in-house while I was their
        marketing manager, and the others are CoThinking clients. A tile with a case study opens it, and the others open
        the site itself.
      </p>
    </Prose>

    {/* The tiles' titles are h3s: this keeps the outline in order. */}
    <h2 class="sr-only">Websites I have built</h2>
    <WorkTiles clients={childrenOf('work', w.live, w.collections)} narrow />

    <NextStep about={page.title} />
  </Fragment>
</Entry>
