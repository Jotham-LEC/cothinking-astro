---
// A problem I fix (`problems`): the offer to do it under the title
// (`what_i_do`, email, WhatsApp, and the `case_study` with its
// `case_study_line`), the Markdown how-to, then the contact block, both naming
// the page.
import { render } from 'astro:content';
import { wiki } from '@garden/lib/load.ts';
import { pageByKey } from '@garden/lib/pages.ts';
import type { LivePage } from '@garden/lib/types.ts';
import Entry from '@garden/components/Entry.astro';
import LightBulb from '@site/assets/icons/light-bulb.svg';
import Email from '@site/components/cothinking/Email.astro';
import Enquiry from '@site/components/cothinking/Enquiry.astro';
import Whatsapp from '@site/components/cothinking/Whatsapp.astro';
type Props = { page: LivePage };
const { page } = Astro.props;
const w = await wiki();
const { Content, headings } = await render(w.entryOf(page));
const caseStudy = pageByKey(w.live, [page.data.case_study].flat()[0] as string | undefined);
const whatIDo = typeof page.data.what_i_do === 'string' ? page.data.what_i_do : null;
---

<Entry page={page} headings={headings}>
  <aside
    slot="before-body"
    id="next-step"
    class="not-prose rounded-site border-rule bg-bg-elev mb-10 border p-5 font-sans sm:px-6"
    aria-labelledby="i-can-do-this"
  >
    <h2 id="i-can-do-this" class="text-heading flex items-center gap-3 text-lg font-semibold">
      <LightBulb class="text-accent size-6 shrink-0" />I can do this for you
    </h2>
    {whatIDo && <p class="mt-3">{whatIDo}</p>}
    <p class="text-muted mt-3">
      I fix what you asked me to fix. If I notice something else along the way, I will tell you and quote for it
      separately, and whether to go ahead is your decision.
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <Email about={page.title}>Send me the details</Email>
      <Whatsapp about={page.title} secondary />
    </div>
    {caseStudy?.url && (
      <p class="mt-4 text-sm">
        {String(page.data.case_study_line ?? '')}
        <a href={caseStudy.url}>See what changed →</a>
      </p>
    )}
  </aside>
  <Content />
  <Enquiry
    slot="after-article"
    about={page.title}
    title="Tell me about it"
    intro="Tell me what is happening, in your own words. If anyone has already looked into it, tell me what they found. I will reply with what I think is wrong and a fixed price, before any work starts."
  />
</Entry>
