---
// The Websites page (`cothinking/websites`): its copy is this view, in Entry's
// `body` slot; the prices come from the settings global.
import { wiki } from '@garden/lib/load.ts';
import { childrenOf } from '@garden/lib/pages.ts';
import type { LivePage } from '@garden/lib/types.ts';
import Entry from '@garden/components/Entry.astro';
import Prose from '@garden/components/Prose.astro';
import SectionHeading from '@garden/components/SectionHeading.astro';
import { emailHref, price } from '@site/lib/contact.ts';
import { relatedPages } from '@site/lib/related.ts';
import Email from '@site/components/cothinking/Email.astro';
import Enquiry from '@site/components/cothinking/Enquiry.astro';
import Related from '@site/components/cothinking/Related.astro';
import Timeline from '@site/components/cothinking/Timeline.astro';
import WorkTiles from '@site/components/cothinking/WorkTiles.astro';
type Props = { page: LivePage };
const { page } = Astro.props;
const w = await wiki();
const { site } = w;
const clients = childrenOf('work', w.live, w.collections).slice(0, 3);
// The outline: the view's own h2s (Blade read them off the rendered body).
const outline = [
  ['packages', 'Packages'],
  ['how-a-build-runs', 'How a build runs'],
  ['not-included', "What's not included"],
  ['after-launch', 'After launch'],
  ['custom-web-apps', 'Custom web apps'],
  ...(clients.length ? [['websites', 'Websites I have built']] : []),
  ...(relatedPages(page.data.related_wiki, w.live).length ? [['related-wiki', 'Read more on the Wiki']] : []),
  ['get-in-touch', 'Ask about a website'],
].map(([id, text]) => ({ level: 2, id: id!, text: text! }));
---

<Entry page={page} extraHeadings={outline}>
  <div class="font-prose" slot="body">
    <Prose class="max-w-3xl">
      <p>
        I build websites in two packages. Most of the small businesses I work with need the same things: a site that
        works well on a phone, and products their staff can update without calling anyone. The Starter Website suits
        most firms, including businesses of one or two people.
      </p>
    </Prose>

    <section class="mt-12" aria-labelledby="packages">
      <h2 id="packages" class="sr-only">
        Packages
      </h2>
      <div class="grid gap-6">
        <article
          id="starter-website"
          class="rounded-site border-rule bg-bg-elev min-w-0 scroll-mt-20 border p-6 wrap-break-word sm:p-8"
        >
          <h3 class="text-heading font-heading text-xl font-extrabold">Starter Website</h3>
          <p class="mt-3 font-sans">
            <span class="text-heading text-4xl font-extrabold">RM{price(site, 'starter_price')}</span>
          </p>
          <p class="text-muted mt-1 font-sans text-sm">Launch price, normally RM{price(site, 'starter_list_price')}.</p>
          <p class="text-muted mt-2 text-sm">Built from your text and photos. Live in about two weeks.</p>
          <Prose class="mt-4">
            <ul>
              <li>Home, About and Contact</li>
              <li>Products and articles your staff can edit, with room for about 30 products</li>
              <li>A WhatsApp button on every page</li>
              <li>
                Set up so Google can read it, with visitor numbers. I can also set up your Google Business Profile,
                quoted separately.
              </li>
            </ul>
          </Prose>
          <p class="mt-6">
            <Email about="the Starter Website">Ask about the Starter</Email>
          </p>
        </article>
        <article
          id="complete-website"
          class="rounded-site border-accent bg-bg-elev min-w-0 scroll-mt-20 border-2 p-6 wrap-break-word sm:p-8"
        >
          <h3 class="text-heading font-heading text-xl font-extrabold">Complete Website</h3>
          <p class="mt-3 font-sans">
            <span class="text-heading text-4xl font-extrabold">RM{price(site, 'complete_price')}</span>
          </p>
          <p class="text-muted mt-1 font-sans text-sm">
            Launch price, normally RM{price(site, 'complete_list_price')}.
          </p>
          <p class="text-muted mt-2 text-sm">I write the copy and design the site. Live in about four weeks.</p>
          <Prose class="mt-4">
            <ul>
              <li>Everything in the Starter</li>
              <li>
                Two kinds of content your staff can edit, such as products and case studies, with room for about 60
                items in total
              </li>
              <li>Copy written after a meeting about your business</li>
              <li>Design for the whole site</li>
              <li>An enquiry form that stores every lead</li>
            </ul>
          </Prose>
          <p class="mt-6">
            <Email about="the Complete Website">Ask about the Complete</Email>
          </p>
        </article>
      </div>
      <p class="text-muted mt-6 max-w-3xl">
        The launch prices are for the first five clients who agree to a short case study that you approve. NGOs always
        pay the launch price. You pay half up front and half before the site goes live. Two rounds of changes are
        included, and you have 7 business days to review each one.
      </p>
      <p class="text-muted mt-4 max-w-3xl">
        If your catalogue is larger than the packages hold, about 30 products in the Starter or about 60 items in the
        Complete, the site is a custom build, and I quote for it in a written proposal. The catalogue of about 400
        products I built for Ultimate Circle is one example. Loading products from supplier PDFs is quoted separately.
      </p>
    </section>

    <section class="mt-16" aria-labelledby="how-a-build-runs">
      <SectionHeading id="how-a-build-runs" title="How a build runs" />
      <Timeline
        steps={[
          { title: 'A short call', text: 'Free, up to 30 minutes. I tell you which package fits.' },
          { title: 'Sign and pay half', text: 'We sign a one-page letter with the package and the price.' },
          { title: 'Build and review', text: 'You review the design twice and tell me what to change.' },
          {
            title: 'Launch',
            text: 'You pay the rest, the site goes live, and I show your staff how to update it.',
          },
        ]}
      />
    </section>

    <div class="mt-16 grid gap-12 md:grid-cols-2">
      <section aria-labelledby="not-included">
        <h2 id="not-included" class="text-heading font-heading text-lg font-extrabold">
          What's not included
        </h2>
        <p class="mt-3">
          Photography, logos, online checkout, and moving an old site's content. Your own photos are usually fine, and I
          can do most of the rest as a separate job, quoted first. The domain stays in your name, and you pay for it
          directly.
        </p>
      </section>
      <section aria-labelledby="after-launch">
        <h2 id="after-launch" class="text-heading font-heading text-lg font-extrabold">
          After launch
        </h2>
        <p class="mt-3">
          Every website comes with 3 months of the Care Plan free, and in that time I fix, at no charge, anything that
          doesn't work as we agreed. After that there is no support unless you subscribe to a Care Plan: RM
          {price(site, 'care_plan_core')} a month for the Starter, or RM{price(site, 'care_plan_complete')} for the
          Complete.
          <a class="text-accent underline underline-offset-2" href="/how-i-work#care-plan">
            More on Care Plans
          </a>
          .
        </p>
      </section>
    </div>

    <section class="mt-16 max-w-3xl" aria-labelledby="custom-web-apps">
      <h2 id="custom-web-apps" class="text-heading font-heading text-lg font-extrabold">
        Custom web apps
      </h2>
      <p class="mt-3">
        If your business needs more than a website, such as customer bookings or stock records your staff can update, I
        can build that too.
        <a class="text-accent underline underline-offset-2" href={emailHref(site, null, 'Enquiry: a custom web app')}>
          Tell me what you have in mind
        </a>
        .
      </p>
    </section>

    {clients.length > 0 && (
      <section class="mt-16" aria-labelledby="websites">
        <SectionHeading id="websites" title="Websites I have built" />
        <WorkTiles clients={clients} narrow />
      </section>
    )}

    <Related keys={page.data.related_wiki} id="related-wiki" title="Read more on the Wiki" />

    <Enquiry
      title="Ask about a website"
      intro="Tell me about your business and what the site is for. I will tell you which package fits and what would cost extra."
      about={page.title}
    />
  </div>
</Entry>
