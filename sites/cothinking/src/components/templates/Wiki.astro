---
// The Wiki page (`cothinking/wiki`): its text, then every wiki entry under its
// category, A to Z (the Explorer's grouping, `group_by: category`).
import { render } from 'astro:content';
import { wiki } from '@garden/lib/load.ts';
import { byCategory } from '@garden/lib/explorer.ts';
import { childrenOf } from '@garden/lib/pages.ts';
import type { LivePage } from '@garden/lib/types.ts';
import Entry from '@garden/components/Entry.astro';
import HeadingLink from '@garden/components/HeadingLink.astro';
import NextStep from '@site/components/cothinking/NextStep.astro';
type Props = { page: LivePage };
const { page } = Astro.props;
const w = await wiki();
const { Content, headings } = await render(w.entryOf(page));
const categories = byCategory(
  childrenOf('wiki', w.live, w.collections),
  w.collections.wiki?.options?.category ?? {},
) as { handle: string; title: string; entries: LivePage[] }[];
---

<Entry
  page={page}
  headings={headings}
  extraHeadings={categories.map((c) => ({ level: 2, id: c.handle, text: c.title }))}
>
  <Content />
  <Fragment slot="after-body">
    {categories.map((category) => (
      <>
        <h2 id={category.handle}>
          <HeadingLink id={category.handle} title={category.title} />
        </h2>
        <ul class="not-prose border-rule divide-rule divide-y border-y">
          {category.entries.map((entry) => (
            <li class="py-4">
              <a class="text-accent font-sans font-semibold" href={entry.url}>
                {entry.title}
              </a>
              {entry.description && <p class="text-muted mt-1">{entry.description}</p>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </Fragment>
  <NextStep slot="after-article" about={page.title} />
</Entry>
