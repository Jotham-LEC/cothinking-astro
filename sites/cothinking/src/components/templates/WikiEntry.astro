---
// A wiki entry (`wiki`): the byline (`author`) under the title; after the
// text (and a reshared essay's, which Entry shows), the `related_pages`, the
// author box and the closing panel.
import { render } from 'astro:content';
import { wiki } from '@garden/lib/load.ts';
import { childrenOf } from '@garden/lib/pages.ts';
import type { LivePage } from '@garden/lib/types.ts';
import Entry from '@garden/components/Entry.astro';
import NextStep from '@site/components/cothinking/NextStep.astro';
import Related from '@site/components/cothinking/Related.astro';
type Props = { page: LivePage };
const { page } = Astro.props;
const w = await wiki();
const { Content, headings } = await render(w.entryOf(page));
const author = w.authors.find((a) => a.id === page.data.author) ?? null;
// The closing panel names the first related problem (in the tree's order), else this entry.
const related = new Set(Array.isArray(page.data.related_pages) ? page.data.related_pages : []);
const problem = childrenOf('problems', w.live, w.collections).find((p) => related.has(`problems/${p.slug}`));
---

<Entry page={page} headings={headings}>
  {author && (
    <p slot="before-body" class="not-prose text-muted -mt-4 mb-8 font-sans text-sm">
      By{' '}
      <a class="text-accent" href={author.url} rel="author">
        {author.name}
      </a>
    </p>
  )}
  <Content />
  <Fragment slot="after-article">
    <Related keys={page.data.related_pages} id="related" title="Related" />
    <footer class="border-rule mt-10 border-t pt-5 font-sans text-sm">
      {author && (
        <>
          <p class="text-heading font-semibold">
            About the author:{' '}
            <a class="text-accent underline underline-offset-2" href={author.url}>
              {author.name}
            </a>
          </p>
          {author.bio && <p class="text-muted mt-1">{author.bio}</p>}
        </>
      )}
    </footer>
    <NextStep about={problem?.title ?? page.title} />
  </Fragment>
</Entry>
