---
// The Problems I fix page (`cothinking/problems`): its text, then every
// problem in the tree's order with its `what_i_do`.
import { render } from 'astro:content';
import { wiki } from '@garden/lib/load.ts';
import { childrenOf } from '@garden/lib/pages.ts';
import type { LivePage } from '@garden/lib/types.ts';
import Entry from '@garden/components/Entry.astro';
import NextStep from '@site/components/cothinking/NextStep.astro';
import ProblemList from '@site/components/cothinking/ProblemList.astro';
type Props = { page: LivePage };
const { page } = Astro.props;
const w = await wiki();
const { Content, headings } = await render(w.entryOf(page));
---

<Entry page={page} headings={headings}>
  <Content />
  <div class="not-prose" slot="after-body">
    <ProblemList problems={childrenOf('problems', w.live, w.collections)} withLine />
  </div>
  <NextStep slot="after-article" about={page.title} />
</Entry>
