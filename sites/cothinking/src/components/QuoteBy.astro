---
// Who gave a testimonial (`client`, a Work entry): a square photo when the
// entry has one (`quote_photo`, cropped to 96px), then the name and the role.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
type Props = { client: CollectionEntry<'work'>; class?: string };
const { client, class: className } = Astro.props;
const photo = client.data.quote_photo ?? null;
---

<figcaption class:list={['text-muted flex items-center gap-3 font-sans text-sm', className]}>
  {photo && (
    <Image
      src={photo}
      alt=""
      width={96}
      height={96}
      fit="cover"
      quality={80}
      class="rounded-site border-rule size-12 shrink-0 border object-cover"
    />
  )}
  <span>
    <span class="text-heading font-semibold">{client.data.quote_by}</span>, {client.data.quote_role}
  </span>
</figcaption>
