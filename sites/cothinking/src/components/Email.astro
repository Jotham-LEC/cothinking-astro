---
// An email button whose subject names the page (`about`), else the site.
// The slot replaces the label.
import Button from '@garden/components/Button.astro';
import { emailHref } from '@site/lib/contact.ts';
type Props = { about?: string | null };
const { about = null } = Astro.props;
---

<Button href={emailHref(about)}>{Astro.slots.has('default') ? <slot /> : 'Email me'}</Button>
