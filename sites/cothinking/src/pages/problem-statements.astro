---
// /problem-statements: the landing page's text, then every problem in the
// tree's order with its `what_i_do`.
import { getCollection, getEntry, render } from 'astro:content';
import Entry from '@garden/components/Entry.astro';
import NextStep from '@site/components/NextStep.astro';
import ProblemList from '@site/components/ProblemList.astro';
const entry = (await getEntry('pages', 'problem-statements'))!;
const { Content, headings } = await render(entry);
const problems = (await getCollection('problems', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Entry entry={entry} headings={headings}>
  <Content />
  <div class="not-prose" slot="after-body">
    <ProblemList problems={problems} withLine />
  </div>
  <NextStep slot="after-article" about={entry.data.title} />
</Entry>
