---
// cothink.ing's home page, a room. Its copy is written here.
import { getEntry } from 'astro:content';
import { garden } from '@garden/lib/load.ts';
import { childrenOf } from '@garden/lib/entry.ts';
import Layout from '@garden/layouts/Layout.astro';
import Prose from '@garden/components/Prose.astro';
import SectionHeading from '@garden/components/SectionHeading.astro';
import ComputerDesktop from '@site/assets/icons/computer-desktop.svg';
import WrenchScrewdriver from '@site/assets/icons/wrench-screwdriver.svg';
import { price } from '@site/lib/contact.ts';
import { testimonialOf, workEntries } from '@site/lib/work.ts';
import { prices } from '@site/site.config.ts';
import AboutMe from '@site/components/cothinking/AboutMe.astro';
import Email from '@site/components/cothinking/Email.astro';
import Enquiry from '@site/components/cothinking/Enquiry.astro';
import ProblemList from '@site/components/cothinking/ProblemList.astro';
import QuoteBy from '@site/components/cothinking/QuoteBy.astro';
import Whatsapp from '@site/components/cothinking/Whatsapp.astro';
import WorkTiles from '@site/components/cothinking/WorkTiles.astro';
const g = await garden();
const page = g.entry((await getEntry('pages', 'home'))!);
const problems = childrenOf('problems', g.live, g.site).slice(0, 5);
const work = await workEntries();
const testimonial = testimonialOf(work);
---

<Layout page={page} path={page.url} html={await g.htmlOf(page)} room>
  <div class="font-prose mx-auto max-w-6xl">
    <header class="lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-12" data-popover>
      <img
        src="/images/cothinking/jotham-desk.webp"
        alt="Jotham Lim at his desk, with a client's website and its code open side by side on his laptop"
        width="960"
        height="960"
        fetchpriority="high"
        class="rounded-site border-rule bg-bg-elev mb-8 aspect-[3/2] w-full max-w-sm border object-cover object-[50%_30%] lg:order-last lg:col-span-5 lg:mb-0 lg:aspect-auto lg:max-w-none"
      />
      <div class="max-w-3xl lg:col-span-7 lg:max-w-none">
        <h1 class="after:bg-accent motion-safe:after:animate-blink text-heading font-heading text-3xl font-extrabold tracking-tight text-balance after:ml-[0.2em] after:inline-block after:h-[0.85em] after:w-[0.5em] after:align-[-0.05em] after:content-[''] sm:text-5xl print:after:hidden">
          Web, IT and marketing services for Malaysian SMEs
        </h1>
        <Prose class="mt-6">
          <p>
            Most SMEs businesses understand that IT/Web is important, but it's never urgent, until something break.
            Based in Petaling Jaya, I help business owners fix immediate technical issues, and setup a solid foundatoin
            so that you can focus on running your core business.
          </p>
          <p class="flex flex-wrap gap-3">
            <Email>Get in touch</Email>
            <Whatsapp secondary />
          </p>
        </Prose>
      </div>
    </header>

    {problems.length > 0 && (
      <section class="mt-24 max-w-3xl" aria-labelledby="problems">
        <SectionHeading id="problems" title="Problems I fix" />
        <ProblemList problems={problems} />
        <p class="mt-6 font-sans text-sm">
          <a class="text-accent" href="/problem-statements">
            See all problems →
          </a>
        </p>
      </section>
    )}

    <section
      class="rounded-site border-rule border-l-accent bg-bg-elev mt-24 max-w-4xl border border-l-4 p-6 sm:p-10"
      aria-labelledby="how-i-work"
    >
      <SectionHeading id="how-i-work" title="Start small" />
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <div class="flex gap-4">
          <span class="bg-accent-soft text-accent flex size-12 shrink-0 items-center justify-center rounded-full">
            <ComputerDesktop class="size-6" />
          </span>
          <div>
            <h3 class="text-heading font-heading text-lg font-extrabold">Websites</h3>
            <p class="mt-1">
              Two website packages, from RM{price(prices.starter)} at the launch price, for the first five
              clients who agree to a short case study.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="bg-accent-soft text-accent flex size-12 shrink-0 items-center justify-center rounded-full">
            <WrenchScrewdriver class="size-6" />
          </span>
          <div>
            <h3 class="text-heading font-heading text-lg font-extrabold">Web, IT and marketing jobs</h3>
            <p class="mt-1">
              You pay only for the jobs you ask for after they are done with a monthly billing, with no minimum spend.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-8 font-sans text-sm">
        <a class="text-accent" href="/how-i-work">
          How I work and prices →
        </a>
      </p>
    </section>

    {testimonial && (
      <figure class="border-accent mt-24 max-w-4xl border-l-4 pl-6 sm:pl-10">
        <blockquote class="text-heading text-2xl leading-snug sm:text-3xl">
          <p>“{testimonial.data.quote}”</p>
        </blockquote>
        <QuoteBy client={testimonial} class="mt-6" />
      </figure>
    )}

    {work.length > 0 && (
      <section class="mt-24" aria-labelledby="websites">
        <SectionHeading id="websites" title="Websites I have built" />
        <WorkTiles clients={work.slice(0, 3)} />
        <p class="mt-8 font-sans text-sm">
          <a class="text-accent" href="/work">
            Past projects →
          </a>
        </p>
      </section>
    )}

    <AboutMe heading="About me" id="about" class="mt-24" />

    <Enquiry />
  </div>
</Layout>
