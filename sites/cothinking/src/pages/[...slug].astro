---
// The site's own pages (but home, index.astro) and the problems I fix, which
// live at the top level too, each by its template (src/components/templates).
import { getCollection } from 'astro:content';
import HowIWork from '@site/components/templates/HowIWork.astro';
import Page from '@site/components/templates/Page.astro';
import Problem from '@site/components/templates/Problem.astro';
import Problems from '@site/components/templates/Problems.astro';
import Websites from '@site/components/templates/Websites.astro';
import Wiki from '@site/components/templates/Wiki.astro';
import Work from '@site/components/templates/Work.astro';
import { urlOf } from '@site/lib/urls.ts';

const TEMPLATES = {
  'cothinking/page': Page,
  'cothinking/problems': Problems,
  'cothinking/wiki': Wiki,
  'cothinking/work': Work,
  'cothinking/how-i-work': HowIWork,
  'cothinking/websites': Websites,
};

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !p.data.draft && p.id !== 'home');
  const problems = await getCollection('problems', (p) => !p.data.draft);
  return [...pages, ...problems].map((entry) => ({
    params: { slug: urlOf(entry.collection, entry.id).slice(1) },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const Template = entry.collection === 'problems' ? null : TEMPLATES[entry.data.template as keyof typeof TEMPLATES];
if (entry.collection === 'pages' && !Template) throw new Error(`${entry.id}: no view for the template ${entry.data.template}.`);
---

{entry.collection === 'problems' ? <Problem entry={entry} /> : Template && <Template entry={entry} />}
