---
// An entry of the wiki collection: the WikiEntry view (src/components/templates).
import { wiki } from '@garden/lib/load.ts';
import WikiEntry from '@site/components/templates/WikiEntry.astro';

export async function getStaticPaths() {
  const w = await wiki();
  return w.live.filter((p) => p.collection === 'wiki').map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
---

<WikiEntry page={page} />
