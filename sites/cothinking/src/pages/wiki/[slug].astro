---
// An entry of the wiki collection: the WikiEntry view (src/components/templates).
import { getCollection } from 'astro:content';
import WikiEntry from '@site/components/templates/WikiEntry.astro';

export async function getStaticPaths() {
  const entries = await getCollection('wiki', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---

<WikiEntry entry={entry} />
