---
// A wiki entry: the byline (the site's `author`) under the title; after the
// text, the `related_pages`, the author box and the closing panel.
import { getCollection, render } from 'astro:content';
import { garden } from '@garden/lib/load.ts';
import { childrenOf } from '@garden/lib/entry.ts';
import Entry from '@garden/components/Entry.astro';
import NextStep from '@site/components/NextStep.astro';
import Related from '@site/components/Related.astro';

export async function getStaticPaths() {
  const entries = await getCollection('wiki', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const g = await garden();
const { Content, headings } = await render(entry);
const { author } = g.site;
// The closing panel names the first related problem (in the tree's order), else this entry.
const related = new Set(entry.data.related_pages ?? []);
const problem = childrenOf('problems', g.live, g.site).find((p) => related.has(`problems/${p.id}`));
---

<Entry entry={entry} headings={headings}>
  {author && (
    <p slot="before-body" class="not-prose text-muted -mt-4 mb-8 font-sans text-sm">
      By{' '}
      <a class="text-accent" href={author.url} rel="author">
        {author.name}
      </a>
    </p>
  )}
  <Content />
  <Fragment slot="after-article">
    <Related keys={entry.data.related_pages} id="related" title="Related" />
    <footer class="border-rule mt-10 border-t pt-5 font-sans text-sm">
      {author && (
        <>
          <p class="text-heading font-semibold">
            About the author:{' '}
            <a class="text-accent underline underline-offset-2" href={author.url}>
              {author.name}
            </a>
          </p>
          <p class="text-muted mt-1">{author.bio}</p>
        </>
      )}
    </footer>
    <NextStep about={problem?.title ?? entry.data.title} />
  </Fragment>
</Entry>
