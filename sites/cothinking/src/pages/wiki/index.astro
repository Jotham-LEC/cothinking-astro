---
// /wiki: the landing page's text, then every wiki entry under its category,
// A to Z (the Explorer's grouping, `explorer: 'by-category'`).
import { getCollection, getEntry, render } from 'astro:content';
import { describeEntry, urlOf } from '@garden/lib/load.ts';
import { groupByCategory } from '@garden/lib/explorer.ts';
import Entry from '@garden/components/Entry.astro';
import HeadingLink from '@garden/components/HeadingLink.astro';
import NextStep from '@site/components/NextStep.astro';
import { site } from '@site/site.config.ts';
const entry = (await getEntry('pages', 'wiki'))!;
const { Content, headings } = await render(entry);
const wiki = await Promise.all(
  (await getCollection('wiki', (e) => !e.data.draft)).map(async (page) => ({
    page,
    description: await describeEntry(page),
  })),
);
const categories = groupByCategory(wiki, site.collections.wiki.categories, ({ page }) => page.data);
---

<Entry
  entry={entry}
  headings={headings}
  extraHeadings={categories.map((c) => ({ level: 2, id: c.handle, text: c.title }))}
>
  <Content />
  <Fragment slot="after-body">
    {categories.map((category) => (
      <>
        <h2 id={category.handle}>
          <HeadingLink id={category.handle} title={category.title} />
        </h2>
        <ul class="not-prose border-rule divide-rule divide-y border-y">
          {category.entries.map(({ page, description }) => (
            <li class="py-4">
              <a class="text-accent font-sans font-semibold" href={urlOf(page)}>
                {page.data.title}
              </a>
              {description && <p class="text-muted mt-1">{description}</p>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </Fragment>
  <NextStep slot="after-article" about={entry.data.title} />
</Entry>
