---
// A client's case study, as a room: the eyebrow, title, screenshot (1280px
// wide at most) and numbers, the write-up, the live site and the closing panel.
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { urlOf } from '@garden/lib/load.ts';
import Layout from '@garden/layouts/Layout.astro';
import PageHeader from '@garden/components/PageHeader.astro';
import Prose from '@garden/components/Prose.astro';
import NextStep from '@site/components/NextStep.astro';
import WorkStats from '@site/components/WorkStats.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { Content } = await render(entry);
const eyebrow = entry.data.eyebrow || [entry.data.year, entry.data.kind].filter(Boolean).join(' · ');
const website = entry.data.website ?? null;
---

<Layout entry={entry} path={urlOf(entry)} room>
  <article class="mx-auto max-w-[72ch]">
    <PageHeader title={entry.data.title} eyebrow={eyebrow} />

    {entry.data.image && (
      <Image
        src={entry.data.image}
        alt={`${entry.data.title}’s website`}
        width={Math.min(1280, entry.data.image.width)}
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="rounded-site border-rule w-full border"
      />
    )}

    <WorkStats stats={entry.data.stats} />

    <Prose class="mt-10" data-popover>
      <Content />
    </Prose>

    <p class="border-rule text-muted mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t pt-5 font-sans text-sm">
      {website && (
        <a class="text-accent" href={website}>
          Visit the live site ↗
        </a>
      )}
      <a class="text-accent" href="/work">
        More work →
      </a>
    </p>

    <NextStep about={entry.data.title} />
  </article>
</Layout>
