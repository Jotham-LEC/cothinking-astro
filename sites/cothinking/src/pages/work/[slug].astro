---
// An entry of the work collection: the CaseStudy view (src/components/templates).
import { getCollection } from 'astro:content';
import CaseStudy from '@site/components/templates/CaseStudy.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', (e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---

<CaseStudy entry={entry} />
