{
  "name": "cothinking-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "astro": "astro",
    "build": "npm run build:jothamlim && npm run build:cothinking",
    "check": "npm run check:jothamlim && npm run check:cothinking",
    "test": "vitest run",
    "format": "prettier --write .",
    "dev:jothamlim": "cd sites/jothamlim && astro dev",
    "build:jothamlim": "astro build --root sites/jothamlim",
    "preview:jothamlim": "cd sites/jothamlim && astro preview",
    "check:jothamlim": "astro sync --root sites/jothamlim && SITE=jothamlim node scripts/check-content.ts && astro check --root sites/jothamlim",
    "import:jothamlim": "SITE=jothamlim node scripts/import-content.mjs",
    "golden:jothamlim": "SITE=jothamlim node scripts/golden.mjs",
    "compare:jothamlim": "SITE=jothamlim node scripts/compare.mjs",
    "smoke:jothamlim": "SITE=jothamlim node tests/smoke.mjs",
    "dev:cothinking": "cd sites/cothinking && astro dev",
    "build:cothinking": "astro build --root sites/cothinking",
    "preview:cothinking": "cd sites/cothinking && astro preview",
    "check:cothinking": "astro sync --root sites/cothinking && SITE=cothinking node scripts/check-content.ts && astro check --root sites/cothinking",
    "import:cothinking": "SITE=cothinking node scripts/import-content.mjs",
    "golden:cothinking": "SITE=cothinking node scripts/golden.mjs",
    "compare:cothinking": "SITE=cothinking node scripts/compare.mjs",
    "smoke:cothinking": "SITE=cothinking node tests/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "astro-pagefind": "^2.0.1",
    "d3-force": "^3.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "image-size": "^2.0.4",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-wiki-link": "^2.0.1",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "node-html-parser": "^9.0.5",
    "playwright": "~1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
