---
// Page not found, as a terminal session: the shell error, the published pages
// Pagefind finds for the address's last segment, and the ways out, also as
// plain buttons. The host, path and suggestions are filled in by the browser,
// as a static page knows no address.
import { wiki } from '../lib/load.ts';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/garden/PageHeader.astro';
import Button from '../components/garden/Button.astro';
const { site } = await wiki();
const host = new URL(site.url).host;
---

<Layout path="/404" seoTitle="Page not found" seoStatus={404}>
  <PageHeader title="404: Page not found" />

  <div class="rounded-site border-rule bg-bg-elev overflow-hidden border font-mono text-sm" data-not-found>
    <div class="border-rule text-muted flex items-center gap-1.5 border-b px-4 py-2 text-xs" aria-hidden="true">
      <span class="bg-danger size-2.5 rounded-full"></span>
      <span class="bg-accent size-2.5 rounded-full"></span>
      <span class="bg-rule-strong size-2.5 rounded-full"></span>
      <span class="ml-2">
        zsh — <span data-not-found-host>{host}</span>
      </span>
    </div>

    <div class="space-y-4 p-4 break-words sm:p-5">
      <p>
        <span class="text-accent">$</span> curl -I{' '}
        <span class="break-all" data-not-found-url>
          {site.url}/404
        </span>
        <br />
        <span class="text-muted">HTTP/2 404 Not Found</span>
      </p>

      <p>
        <span class="text-accent">$</span> cd{' '}
        <span class="break-all" data-not-found-path>
          /404
        </span>
        <br />
        <span class="text-danger break-all">
          zsh: no such file or directory: <span data-not-found-path>/404</span>
        </span>
      </p>

      <div hidden data-not-found-search>
        <p>
          <span class="text-accent">$</span> grep -ril "<span data-not-found-guess></span>" ~
        </p>
        <p class="text-muted" hidden data-not-found-some>
          # Did you mean:
        </p>
        <ul class="space-y-1.5" data-not-found-suggestions></ul>
        <p class="text-muted" hidden data-not-found-none>
          grep: no matches
        </p>
      </div>

      <p>
        <span class="text-accent">$</span>
        <a class="text-accent underline underline-offset-2" href="/">
          cd ~
        </a>
        <span class="text-muted"> # back to the home page</span>
        <br />
        <span class="text-accent">$</span> <span class="text-muted"># or search the site: press ⌘K</span>
      </p>

      <p>
        <span class="text-accent">$</span>
        <span
          class="bg-accent motion-safe:animate-blink inline-block h-[1.1em] w-[0.55em] align-[-0.2em]"
          aria-hidden="true"
        ></span>
      </p>
    </div>
  </div>

  <p class="mt-8 flex flex-wrap gap-3">
    <Button href="/">Go to the home page</Button>
    <Button type="button" secondary data-palette-open>
      Search the site
    </Button>
  </p>

  <script>
    // The address that was asked for, and up to five pages whose text matches its last segment.
    import { cleanUrl, loadPagefind } from '../scripts/site/pagefind.js';
    const root = document.querySelector('[data-not-found]');
    if (root) {
      let path = location.pathname;
      try {
        path = decodeURIComponent(path);
      } catch {
        // A malformed escape (`/%E0%A4%A`): show the address as it came.
      }
      root.querySelectorAll('[data-not-found-host]').forEach((el) => (el.textContent = location.host));
      root.querySelectorAll('[data-not-found-url]').forEach((el) => (el.textContent = location.origin + path));
      root.querySelectorAll('[data-not-found-path]').forEach((el) => (el.textContent = path));
      const guess = (path.split('/').filter(Boolean).pop() ?? '').replace(/[-_]/g, ' ').trim();
      const search = root.querySelector('[data-not-found-search]') as HTMLElement | null;
      if (guess.length >= 2 && search) {
        search.hidden = false;
        root.querySelector('[data-not-found-guess]')!.textContent = guess;
        const list = root.querySelector('[data-not-found-suggestions]')!;
        loadPagefind()
          .then(async (pagefind) => {
            const found = await pagefind.search(guess);
            const pages = await Promise.all(
              found.results
                .slice(0, 5)
                .map((r: { data: () => Promise<{ url: string; meta: { title: string } }> }) => r.data()),
            );
            for (const page of pages) {
              const url = cleanUrl(page.url);
              const li = document.createElement('li');
              const a = document.createElement('a');
              a.className = 'text-accent break-all underline underline-offset-2';
              a.href = url;
              a.textContent = '.' + url;
              const title = document.createElement('span');
              title.className = 'text-muted block pl-4';
              title.textContent = '└ ' + page.meta.title;
              li.append(a, title);
              list.appendChild(li);
            }
            (
              root.querySelector(pages.length ? '[data-not-found-some]' : '[data-not-found-none]') as HTMLElement
            ).hidden = false;
          })
          .catch(() => ((root.querySelector('[data-not-found-none]') as HTMLElement).hidden = false));
      }
    }
  </script>
</Layout>
