---
// /notes (template `notes/index`) and /notes/2, /notes/3…: the landing page's
// text, then the stream, 20 to a page, newest first.
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { wiki } from '../../lib/load.ts';
import { byDateDesc, landingOf } from '../../lib/pages.ts';
import Entry from '../../components/garden/Entry.astro';
import Stream from '../../components/notes/Stream.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const w = await wiki();
  const landing = landingOf('notes', w.live, w.collections);
  if (!landing) return [];
  const notes = byDateDesc(w.live.filter((p) => p.collection === 'notes'));
  return paginate(notes, { pageSize: 20, props: { landing } });
}) satisfies GetStaticPaths;

const { page, landing } = Astro.props;
const w = await wiki();
const { Content, headings } = await render(w.entryOf(landing));
---

<Entry page={landing} path={page.url.current} headings={headings}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Content />
  <Stream slot="after-article" page={page} />
</Entry>
