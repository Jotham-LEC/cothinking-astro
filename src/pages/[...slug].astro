---
// The pages collection (career, cv, sports) and the section landing pages, by
// template: `default`, `section` (the mounted collection newest first),
// `publications` (the archive by year). Home is index.astro; the notes
// landing page is notes/[...page].astro, as it paginates.
import { render } from 'astro:content';
import { wiki } from '../lib/load.ts';
import { childrenOf, mountedOn } from '../lib/pages.ts';
import { years } from '../lib/years.ts';
import Entry from '../components/garden/Entry.astro';
import ArchiveRow from '../components/garden/ArchiveRow.astro';

export async function getStaticPaths() {
  const w = await wiki();
  return w.live
    .filter((p) => p.collection === 'pages' && p.url !== '/' && p.template !== 'notes/index')
    .map((p) => ({ params: { slug: p.url!.slice(1) }, props: { page: p } }));
}
const { page } = Astro.props;
const w = await wiki();
const { Content, headings } = await render(w.entryOf(page));
const mount = mountedOn(page, w.collections);
const listing = page.template === 'section' && mount ? childrenOf(mount, w.live, w.collections) : [];
const archive = page.template === 'publications' ? years(page, w.live, w.collections) : [];
---

<Entry page={page} headings={headings}>
  <Content />
  <Fragment slot="after-body">
    {listing.length > 0 && (
      <ul class="not-prose list-none p-0" data-archive>
        {listing.map((entry) => (
          <ArchiveRow date={entry.date} url={entry.url!} title={entry.title} />
        ))}
      </ul>
    )}
    {archive.map((group) => (
      <>
        <h2 id={group.year}>{group.year}</h2>
        <ul class="not-prose list-none p-0" data-archive>
          {group.pieces.map((piece) => (
            <ArchiveRow date={piece.date} url={piece.url} title={piece.title} note={piece.outlet} />
          ))}
        </ul>
      </>
    ))}
  </Fragment>
</Entry>
