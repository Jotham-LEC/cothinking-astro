---
// `~ / Section` breadcrumbs up to the current page's parent. A page with no
// entry behind its address (a note type listing) sets `currentCrumb`, and the
// last found crumb then shows as its parent.
import { breadcrumbs } from '@lib/breadcrumbs.ts';
import type { Page } from '@lib/types.ts';
type Props = { url: string; pages: Page[]; currentCrumb?: boolean };
const { url, pages, currentCrumb = false } = Astro.props;
const crumbs = breadcrumbs(url, pages);
---

<nav class="text-muted mb-4 flex flex-wrap items-center gap-x-1.5 text-sm" aria-label="Breadcrumb" data-pagefind-ignore>
  {crumbs.map((crumb, i) => {
    const first = i === 0;
    const last = i === crumbs.length - 1;
    if (last && !first && !currentCrumb) return null;
    return (
      <>
        {!first && (
          <Fragment>
            {' '}
            <span class="text-subtle" aria-hidden="true">
              /
            </span>{' '}
          </Fragment>
        )}
        {first ? (
          <a
            class="hover:text-fg -mx-2 inline-flex min-w-6 justify-center px-2 pointer-coarse:py-2"
            href={crumb.url}
            aria-label="Home"
          >
            ~
          </a>
        ) : (
          <a class="hover:text-fg pointer-coarse:py-2" href={crumb.url}>
            {crumb.title}
          </a>
        )}
      </>
    );
  })}
</nav>
