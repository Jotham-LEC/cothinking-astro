---
// A call to action: the yellow button, or `secondary`, an outlined one. A link
// with `href`, else a <button>. `not-prose` keeps its colours inside <Prose>;
// Markdown writes `<a class="button">` instead.
type Props = { href?: string; secondary?: boolean; type?: string; [key: string]: unknown };
const { href, secondary = false, type = 'submit', ...rest } = Astro.props;
const classes = [
  'not-prose rounded-site inline-flex items-center gap-2 px-4 py-2.5 font-sans text-sm font-bold no-underline transition',
  secondary ? 'border-subtle text-heading hover:bg-bg border' : 'bg-button-bg text-button-fg hover:brightness-95',
];
---

{href ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
  </button>
)}
