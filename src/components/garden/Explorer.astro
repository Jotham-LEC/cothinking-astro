---
// The Explorer: the whole site as one tree (src/lib/explorer.ts). Folders
// are closed unless they hold the current page; the JS remembers what you open.
import type { Row } from '@lib/explorer.ts';
import ExplorerRows from './ExplorerRows.astro';
type Props = { rows: Row[] };
const { rows } = Astro.props;
---

<nav aria-label="Explorer" class="text-sm" data-pagefind-ignore>
  <ExplorerRows rows={rows} depth={0} />
</nav>
