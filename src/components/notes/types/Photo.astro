---
// Each photo at its own size (the media files are already shrunk on upload). Two or more sit in a grid.
import { measure } from '../../../lib/markdown/rehype-images.ts';
import { publicDir } from '../../../lib/paths.ts';
import type { Page } from '../../../lib/types.ts';
type Props = { note: Page };
const { note } = Astro.props;
const photos = (Array.isArray(note.data.photos) ? (note.data.photos as string[]) : []).map((src) => ({
  src,
  ...(measure(publicDir, src) ?? {}),
}));
---

<div class:list={['grid gap-0.5', { 'grid-cols-2': photos.length > 1 }]}>
  {photos.map((photo) => (
    <img
      src={photo.src}
      alt=""
      width={photo.width}
      height={photo.height}
      loading="lazy"
      decoding="async"
      class="zoomable m-0 block h-auto w-full rounded-none border-0"
    />
  ))}
</div>
