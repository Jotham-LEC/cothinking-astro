---
// The quote, large; the rule under it separates it from the note's text, when there is any.
import { renderFeed } from '../../../wiki/markdown/feed.ts';
import { wiki } from '../../../wiki/load.ts';
import type { Page } from '../../../wiki/types.ts';
type Props = { note: Page };
const { note } = Astro.props;
const { titles } = await wiki();
const quote = typeof note.data.quote === 'string' ? await renderFeed(note.data.quote, titles, { breaks: true }) : '';
const cite = typeof note.data.cite === 'string' ? note.data.cite : null;
---

<blockquote class="border-rule text-fg font-prose m-0 border-0 border-b px-6 py-7 text-2xl leading-snug font-bold italic last:border-b-0">
  <Fragment set:html={quote} />
  {cite && <cite class="text-muted mt-3 block font-sans text-base font-medium not-italic">— {cite}</cite>}
</blockquote>
