---
// A heading's text as a link to itself, the same markup rehype-heading-anchors
// gives a Markdown heading.
import { ANCHOR_PATH } from '../wiki/markdown/rehype-heading-anchors.ts';
type Props = { id: string; title: string };
const { id, title } = Astro.props;
---

<a class="anchor" href={`#${id}`}>
  {title}
  <svg class="anchor-icon" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" d={ANCHOR_PATH} />
  </svg>
</a>
